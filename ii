<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>편한가계부 Style</title>
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" rel="stylesheet">
<style>
  :root {
    --bg-main: #F4F5F7;
    --bg-card: #FFFFFF;
    --primary-red: #E54B4B;
    --primary-blue: #3B82F6;
    --text-dark: #191F28;
    --text-sub: #8B95A1;
    --line-color: #E5E8EB;
    --badge-sat: #2563EB;
    --badge-sun: #DC2626;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  body {
    margin: 0; padding: 0;
    background-color: var(--bg-main);
    color: var(--text-dark);
    font-family: 'Pretendard', -apple-system, sans-serif;
  }
  .app-container {
    max-width: 480px;
    margin: 0 auto;
    min-height: 100vh;
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 0 20px rgba(0,0,0,0.05);
  }

  /* Header Header & Sub-Tabs */
  header {
    background: #FF5A5F;
    color: #FFF;
    padding: 14px 16px 0;
    position: sticky; top: 0; z-index: 10;
  }
  .header-top {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 18px; font-weight: 700; padding-bottom: 12px;
  }
  .month-picker {
    display: flex; align-items: center; gap: 12px; font-size: 16px;
  }
  .month-picker button {
    background: none; border: none; color: #FFF; font-size: 18px; cursor: pointer;
  }
  .view-tabs {
    display: flex; background: rgba(0,0,0,0.08); border-radius: 8px 8px 0 0; overflow: hidden;
  }
  .view-tab {
    flex: 1; text-align: center; padding: 10px 0; font-size: 14px; font-weight: 600;
    color: rgba(255,255,255,0.7); cursor: pointer; border-bottom: 3px solid transparent;
  }
  .view-tab.active {
    color: #FFF; border-bottom-color: #FFF; font-weight: 700;
  }

  /* Total Summary Bar */
  .summary-bar {
    display: flex; justify-content: space-around; background: #FFF;
    padding: 12px 16px; border-bottom: 1px solid var(--line-color);
  }
  .sum-item { text-align: center; }
  .sum-label { font-size: 11px; color: var(--text-sub); margin-bottom: 3px; }
  .sum-val { font-size: 14px; font-weight: 700; }
  .sum-val.inc { color: var(--primary-blue); }
  .sum-val.exp { color: var(--primary-red); }

  /* Main View Content Area */
  .content-body { flex: 1; padding-bottom: 80px; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }

  /* 1. Daily View (일일) */
  .day-group { border-bottom: 8px solid var(--bg-main); }
  .day-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 10px 16px; background: #FAFAFA; border-bottom: 1px solid var(--line-color);
  }
  .day-info { display: flex; align-items: center; gap: 8px; }
  .day-num { font-size: 18px; font-weight: 700; }
  .day-badge {
    font-size: 10px; padding: 2px 6px; border-radius: 4px; color: #FFF; font-weight: 600; background: var(--text-sub);
  }
  .day-badge.sat { background: var(--badge-sat); }
  .day-badge.sun { background: var(--badge-sun); }
  .day-sum { font-size: 12px; font-weight: 600; }
  
  .tx-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 16px; border-bottom: 1px solid var(--line-color);
  }
  .tx-row:last-child { border-bottom: none; }
  .tx-cat { font-size: 12px; color: var(--text-sub); width: 64px; }
  .tx-detail { flex: 1; margin: 0 10px; }
  .tx-title { font-size: 14px; font-weight: 500; }
  .tx-asset { font-size: 11px; color: var(--text-sub); margin-top: 2px; }
  .tx-amt { font-size: 14px; font-weight: 700; }
  .tx-amt.expense { color: var(--primary-red); }
  .tx-amt.income { color: var(--primary-blue); }

  /* 2. Calendar View (달력) */
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); border-bottom: 1px solid var(--line-color); }
  .cal-head { text-align: center; padding: 8px 0; font-size: 12px; font-weight: 600; color: var(--text-sub); }
  .cal-head.sun { color: var(--primary-red); }
  .cal-head.sat { color: var(--primary-blue); }
  .cal-cell {
    min-height: 58px; border-right: 1px solid var(--line-color); border-bottom: 1px solid var(--line-color);
    padding: 4px; font-size: 11px; cursor: pointer; position: relative;
  }
  .cal-cell:nth-child(7n) { border-right: none; }
  .cal-cell.other { opacity: 0.3; }
  .cal-cell.selected { background: #FFF5F5; border: 2px solid var(--primary-red); }
  .cal-num { font-weight: 600; margin-bottom: 2px; }
  .cal-amt { font-size: 9px; text-align: right; line-height: 1.1; }

  /* Floating Add Button (+) */
  .fab {
    position: fixed; bottom: 24px; right: calc(50% - 220px);
    width: 52px; height: 52px; border-radius: 50%;
    background: #FF5A5F; color: #FFF; border: none;
    font-size: 28px; box-shadow: 0 4px 12px rgba(255,90,95,0.4);
    cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 20;
  }
  @media (max-width: 480px) { .fab { right: 20px; } }

  /* Modal Form */
  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5); display: none; justify-content: center; align-items: flex-end; z-index: 30;
  }
  .modal-overlay.active { display: flex; }
  .modal-card {
    background: #FFF; width: 100%; max-width: 480px; border-radius: 16px 16px 0 0;
    padding: 20px; animation: slideUp 0.2s ease-out;
  }
  @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .type-selector { display: flex; gap: 8px; margin-bottom: 12px; }
  .type-btn {
    flex: 1; padding: 8px; border: 1px solid var(--line-color); border-radius: 6px;
    background: #FFF; font-size: 13px; font-weight: 600; cursor: pointer;
  }
  .type-btn.active.exp { background: var(--primary-red); color: #FFF; border-color: var(--primary-red); }
  .type-btn.active.inc { background: var(--primary-blue); color: #FFF; border-color: var(--primary-blue); }

  .form-group { margin-bottom: 10px; }
  .form-group label { display: block; font-size: 11px; color: var(--text-sub); margin-bottom: 4px; }
  .form-group input, .form-group select {
    width: 100%; padding: 10px; border: 1px solid var(--line-color); border-radius: 6px; font-size: 14px;
  }
  .submit-btn {
    width: 100%; padding: 12px; background: #FF5A5F; color: #FFF; border: none; border-radius: 6px;
    font-size: 15px; font-weight: 700; cursor: pointer; margin-top: 10px;
  }
</style>
</head>
<body>

<div class="app-container">
  <header>
    <div class="header-top">
      <div>가계부</div>
      <div class="month-picker">
        <button id="prevM">‹</button>
        <span id="monthTxt">2026.08</span>
        <button id="nextM">›</button>
      </div>
    </div>
    <div class="view-tabs">
      <div class="view-tab active" data-tab="daily">일일</div>
      <div class="view-tab" data-tab="calendar">달력</div>
      <div class="view-tab" data-tab="stats">통계</div>
    </div>
  </header>

  <div class="summary-bar">
    <div class="sum-item">
      <div class="sum-label">수입</div>
      <div class="sum-val inc" id="totInc">0</div>
    </div>
    <div class="sum-item">
      <div class="sum-label">지출</div>
      <div class="sum-val exp" id="totExp">0</div>
    </div>
    <div class="sum-item">
      <div class="sum-label">합계</div>
      <div class="sum-val" id="totTotal">0</div>
    </div>
  </div>

  <div class="content-body">
    <!-- 일일 뷰 -->
    <div class="tab-content active" id="tab-daily"></div>

    <!-- 달력 뷰 -->
    <div class="tab-content" id="tab-calendar">
      <div class="cal-grid">
        <div class="cal-head sun">일</div>
        <div class="cal-head">월</div>
        <div class="cal-head">화</div>
        <div class="cal-head">수</div>
        <div class="cal-head">목</div>
        <div class="cal-head">금</div>
        <div class="cal-head sat">토</div>
      </div>
      <div class="cal-grid" id="calGrid"></div>
      <div id="calSelectedList" style="margin-top: 12px;"></div>
    </div>

    <!-- 통계 뷰 -->
    <div class="tab-content" id="tab-stats" style="padding: 16px;">
      <div id="statsList"></div>
    </div>
  </div>

  <button class="fab" id="openModal">+</button>
</div>

<!-- 내역 추가 모달 -->
<div class="modal-overlay" id="modal">
  <div class="modal-card">
    <div class="modal-header">
      <strong style="font-size:16px;">내역 추가</strong>
      <button id="closeModal" style="background:none;border:none;font-size:18px;cursor:pointer;">✕</button>
    </div>
    <div class="type-selector">
      <button class="type-btn active exp" id="btnTypeExp">지출</button>
      <button class="type-btn" id="btnTypeInc">수입</button>
    </div>
    <div class="form-group">
      <label>날짜</label>
      <input type="date" id="inDate">
    </div>
    <div class="form-group">
      <label>자산(수단)</label>
      <select id="inAsset">
        <option>현금</option>
        <option>신용카드</option>
        <option>체크카드</option>
        <option>은행계좌</option>
      </select>
    </div>
    <div class="form-group">
      <label>카테고리</label>
      <select id="inCat"></select>
    </div>
    <div class="form-group">
      <label>금액</label>
      <input type="number" id="inAmt" placeholder="0" inputmode="numeric">
    </div>
    <div class="form-group">
      <label>내용/메모</label>
      <input type="text" id="inMemo" placeholder="사용 내역 입력">
    </div>
    <button class="submit-btn" id="saveBtn">저장하기</button>
  </div>
</div>

<script>
const CATS = {
  exp: ['식비', '교통비', '생필품', '의료/건강', '문화/여가', '경조사', '기타'],
  inc: ['월급', '용돈', '부수입', '기타']
};

let txs = JSON.parse(localStorage.getItem('convenient_ledger') || '[]');
let curMonth = new Date(); curMonth.setDate(1);
let curType = 'exp';
let selectedCalDate = null;

const fmt = n => n.toLocaleString('ko-KR') + '원';
const fmtK = n => n >= 10000 ? Math.floor(n/10000) + '만' : n.toLocaleString('ko-KR');

function init() {
  document.getElementById('inDate').value = new Date().toISOString().substring(0, 10);
  updateCatOptions();
  render();
}

// 탭 전환 이벤트
document.querySelectorAll('.view-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.view-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
  });
});

// 달 이동
document.getElementById('prevM').onclick = () => { curMonth.setMonth(curMonth.getMonth() - 1); render(); };
document.getElementById('nextM').onclick = () => { curMonth.setMonth(curMonth.getMonth() + 1); render(); };

// 모달 제어
const modal = document.getElementById('modal');
document.getElementById('openModal').onclick = () => modal.classList.add('active');
document.getElementById('closeModal').onclick = () => modal.classList.remove('active');

document.getElementById('btnTypeExp').onclick = function() {
  curType = 'exp';
  this.className = 'type-btn active exp';
  document.getElementById('btnTypeInc').className = 'type-btn';
  updateCatOptions();
};
document.getElementById('btnTypeInc').onclick = function() {
  curType = 'inc';
  this.className = 'type-btn active inc';
  document.getElementById('btnTypeExp').className = 'type-btn';
  updateCatOptions();
};

function updateCatOptions() {
  const sel = document.getElementById('inCat');
  sel.innerHTML = CATS[curType].map(c => `<option>${c}</option>`).join('');
}

document.getElementById('saveBtn').onclick = () => {
  const date = document.getElementById('inDate').value;
  const amt = parseInt(document.getElementById('inAmt').value, 10);
  if (!date || !amt) return;
  txs.push({
    id: Date.now(),
    date, type: curType,
    asset: document.getElementById('inAsset').value,
    cat: document.getElementById('inCat').value,
    amt, memo: document.getElementById('inMemo').value
  });
  localStorage.setItem('convenient_ledger', JSON.stringify(txs));
  modal.classList.remove('active');
  document.getElementById('inAmt').value = '';
  document.getElementById('inMemo').value = '';
  render();
};

function render() {
  const y = curMonth.getFullYear();
  const m = curMonth.getMonth();
  const mKey = `${y}-${String(m+1).padStart(2,'0')}`;
  document.getElementById('monthTxt').textContent = `${y}.${String(m+1).padStart(2,'0')}`;

  const monthData = txs.filter(t => t.date.startsWith(mKey));
  
  let incSum = 0, expSum = 0;
  monthData.forEach(t => t.type === 'inc' ? incSum += t.amt : expSum += t.amt);
  document.getElementById('totInc').textContent = fmt(incSum);
  document.getElementById('totExp').textContent = fmt(expSum);
  document.getElementById('totTotal').textContent = fmt(incSum - expSum);

  renderDaily(monthData);
  renderCalendar(y, m, monthData);
  renderStats(monthData, expSum);
}

function renderDaily(data) {
  const container = document.getElementById('tab-daily');
  if (!data.length) {
    container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-sub);">등록된 내역이 없습니다.</div>';
    return;
  }
  const groups = {};
  data.forEach(t => { (groups[t.date] = groups[t.date] || []).push(t); });
  
  container.innerHTML = Object.keys(groups).sort().reverse().map(d => {
    const dObj = new Date(d + 'T00:00:00');
    const dayNum = dObj.getDate();
    const dayIdx = dObj.getDay();
    const days = ['일', '월', '화', '수', '목', '금', '토'];
    const badgeCls = dayIdx === 0 ? 'sun' : (dayIdx === 6 ? 'sat' : '');
    
    const items = groups[d].map(t => `
      <div class="tx-row">
        <div class="tx-cat">${t.cat}</div>
        <div class="tx-detail">
          <div class="tx-title">${t.memo || t.cat}</div>
          <div class="tx-asset">${t.asset}</div>
        </div>
        <div class="tx-amt ${t.type === 'exp' ? 'expense' : 'income'}">
          ${t.type === 'exp' ? '-' : '+'}${fmt(t.amt)}
        </div>
      </div>
    `).join('');

    return `
      <div class="day-group">
        <div class="day-header">
          <div class="day-info">
            <span class="day-num">${dayNum}</span>
            <span class="day-badge ${badgeCls}">${days[dayIdx]}요일</span>
          </div>
        </div>
        ${items}
      </div>
    `;
  }).join('');
}

function renderCalendar(y, m, data) {
  const grid = document.getElementById('calGrid');
  const first = new Date(y, m, 1).getDay();
  const last = new Date(y, m + 1, 0).getDate();
  const dailyTotals = {};
  data.forEach(t => {
    if (!dailyTotals[t.date]) dailyTotals[t.date] = { inc: 0, exp: 0 };
    dailyTotals[t.date][t.type] += t.amt;
  });

  let html = '';
  for (let i = 0; i < first; i++) html += '<div class="cal-cell other"></div>';
  for (let d = 1; d <= last; d++) {
    const dStr = `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const tot = dailyTotals[dStr] || { inc: 0, exp: 0 };
    const isSel = dStr === selectedCalDate ? 'selected' : '';
    html += `
      <div class="cal-cell ${isSel}" onclick="selectCal('${dStr}')">
        <div class="cal-num">${d}</div>
        <div class="cal-amt">
          ${tot.inc ? `<div style="color:var(--primary-blue)">+${fmtK(tot.inc)}</div>` : ''}
          ${tot.exp ? `<div style="color:var(--primary-red)">-${fmtK(tot.exp)}</div>` : ''}
        </div>
      </div>
    `;
  }
  grid.innerHTML = html;
}

function selectCal(dStr) {
  selectedCalDate = selectedCalDate === dStr ? null : dStr;
  render();
  const listCon = document.getElementById('calSelectedList');
  if (!selectedCalDate) { listCon.innerHTML = ''; return; }
  const dayTxs = txs.filter(t => t.date === selectedCalDate);
  listCon.innerHTML = `<div style="padding:0 16px;font-weight:700;margin-bottom:8px;">${selectedCalDate} 내역</div>` +
    (dayTxs.length ? dayTxs.map(t => `
      <div class="tx-row">
        <div class="tx-cat">${t.cat}</div>
        <div class="tx-detail"><div class="tx-title">${t.memo || t.cat}</div></div>
        <div class="tx-amt ${t.type === 'exp' ? 'expense' : 'income'}">${fmt(t.amt)}</div>
      </div>
    `).join('') : '<div style="padding:16px;color:var(--text-sub);">내역이 없습니다.</div>');
}

function renderStats(data, expSum) {
  const container = document.getElementById('statsList');
  const catMap = {};
  data.filter(t => t.type === 'exp').forEach(t => { catMap[t.cat] = (catMap[t.cat] || 0) + t.amt; });
  const sorted = Object.entries(catMap).sort((a,b) => b[1] - a[1]);

  if (!sorted.length) {
    container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-sub);">지출 데이터가 없습니다.</div>';
    return;
  }
  container.innerHTML = sorted.map(([cat, amt]) => {
    const pct = Math.round((amt / expSum) * 100);
    return `
      <div style="margin-bottom:14px;">
        <div style="display:flex;justify-between;font-size:13px;margin-bottom:4px;">
          <span>${cat} (${pct}%)</span>
          <strong>${fmt(amt)}</strong>
        </div>
        <div style="height:8px;background:#E5E8EB;border-radius:4px;overflow:hidden;">
          <div style="width:${pct}%;height:100%;background:var(--primary-red);"></div>
        </div>
      </div>
    `;
  }).join('');
}

init();
</script>
</body>
</html>
